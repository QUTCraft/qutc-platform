APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=qutcraft:qutcraft@tcp(localhost:3306)/qutcraft?charset=utf8mb4&parseTime=True&loc=UTC
JWT_ISSUER=qutcraft-platform
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1
DEFAULT_ORGANIZATION_SLUG=qutcraft
# 仅限开发环境的首个所有者；生产环境应通过安全的部署变量注入。
BOOTSTRAP_ADMIN_EMAIL=admin@qutcraft.local
BOOTSTRAP_ADMIN_PASSWORD=demo-admin-pass
BOOTSTRAP_ADMIN_NAME=QUTCraft Admin
