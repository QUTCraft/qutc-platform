APP_ENV=development
HTTP_ADDR=:8080
MYSQL_DSN=qutcraft:qutcraft@tcp(localhost:3306)/qutcraft?charset=utf8mb4&parseTime=True&loc=UTC
JWT_ISSUER=qutcraft-platform
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://localhost,http://127.0.0.1
AUTH_RATE_LIMIT_PER_MINUTE=20
PUBLIC_WRITE_LIMIT_PER_HOUR=10
SENSITIVE_RATE_LIMIT_PER_MINUTE=30
DEFAULT_ORGANIZATION_SLUG=qutcraft
# 仅限开发环境的首个所有者；生产环境应通过安全的部署变量注入。
BOOTSTRAP_ADMIN_EMAIL=admin@qutcraft.local
BOOTSTRAP_ADMIN_PASSWORD=demo-admin-pass
BOOTSTRAP_ADMIN_NAME=QUTCraft Admin
# 仅在本地/比赛演示环境显式启用；生产环境必须为 false。
DEMO_SEED_ENABLED=true
# 媒体存储：local 使用本机目录；s3 兼容 MinIO 与标准 S3 服务。
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/tmp/qutcraft-uploads
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=qutcraft-media
S3_REGION=us-east-1
S3_USE_SSL=false
# 邮件默认关闭；启用后仅由 API 读取凭据，浏览器不会接收或保存 SMTP 密码。
PUBLIC_WEB_BASE_URL=http://localhost:8082
EMAIL_DRIVER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=QUTCraft Commons
SMTP_SECURITY=starttls
SMTP_TIMEOUT=8s
# AI 智能体：本地直接运行默认关闭；开发 Mock 必须显式启用，生产环境禁止 mock。
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mock-content-v1
AI_REQUEST_TIMEOUT=30s
AI_RUN_LIMIT_PER_HOUR=20
