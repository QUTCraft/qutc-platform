MYSQL_DATABASE=qutcraft
MYSQL_USER=qutcraft
MYSQL_PASSWORD=qutcraft
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=8082
SWAGGER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://localhost,http://127.0.0.1
AUTH_RATE_LIMIT_PER_MINUTE=20
PUBLIC_WRITE_LIMIT_PER_HOUR=10
SENSITIVE_RATE_LIMIT_PER_MINUTE=30
VITE_API_BASE_URL=http://localhost:8080
JWT_ISSUER=qutcraft-platform
JWT_ACCESS_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
SERVER_ADAPTER_TIMEOUT=5s
DEFAULT_ORGANIZATION_SLUG=qutcraft
BOOTSTRAP_ADMIN_EMAIL=admin@qutcraft.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-development-password
BOOTSTRAP_ADMIN_NAME=QUTCraft Admin
# 复制此示例用于本地演示时可开启；生产环境必须关闭。
DEMO_SEED_ENABLED=true
# 启动可选对象存储：docker compose --profile storage up
# 启动 Swagger UI：docker compose --profile docs up
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-change-me
