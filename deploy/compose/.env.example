MYSQL_DATABASE=qutcraft
MYSQL_USER=qutcraft
MYSQL_PASSWORD=qutcraft
MYSQL_ROOT_PASSWORD=root-change-me
MYSQL_PORT=3306
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=8082
VITE_ORGANIZATION_SLUG=qutcraft
SWAGGER_PORT=8081
CORS_ALLOWED_ORIGINS=http://localhost:8082,http://127.0.0.1:8082,http://localhost,http://127.0.0.1
AUTH_RATE_LIMIT_PER_MINUTE=20
PUBLIC_WRITE_LIMIT_PER_HOUR=10
SENSITIVE_RATE_LIMIT_PER_MINUTE=30
# 留空即使用 Web 容器内置的同源 /api 反向代理（推荐）。
VITE_API_BASE_URL=
JWT_ISSUER=qutcraft-platform
JWT_ACCESS_SECRET=replace-with-a-long-random-production-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
SERVER_ADAPTER_TIMEOUT=5s
# 可选：把 PNG/JPEG/WebP 图片转发到 Superbed 图床。留空或未启用时自动使用本地存储。
SUPERBED_ENABLED=false
SUPERBED_TOKEN=
SUPERBED_UPLOAD_URL=https://api.superbed.cn/upload
SUPERBED_TIMEOUT=30s
DEFAULT_ORGANIZATION_SLUG=qutcraft
BOOTSTRAP_ADMIN_EMAIL=admin@qutcraft.local
BOOTSTRAP_ADMIN_PASSWORD=change-this-development-password
BOOTSTRAP_ADMIN_NAME=QUTCraft Admin
# 默认不创建任何演示业务数据；仅在隔离的本地演示库中显式开启。
DEMO_SEED_ENABLED=false
# qutcraft 用于社团演示；generic 用于比赛通用组织演示。
DEMO_SEED_PROFILE=qutcraft
# 同时创建 QUTCraft 与通用社团资料；仅限显式 Demo Seed，生产必须关闭。
DEMO_SEED_MULTI_ORGANIZATION=false
# 默认使用本地媒体卷。启用 MinIO 时改为 s3，并使用 --profile storage 启动。
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/tmp/qutcraft-uploads
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-change-me
S3_BUCKET=qutcraft-media
S3_REGION=us-east-1
S3_USE_SSL=false
# 邀请邮件适配器。默认关闭时仍可复制邀请链接完成成员加入。
PUBLIC_WEB_BASE_URL=http://localhost:8082
EMAIL_DRIVER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=QUTCraft Commons
SMTP_SECURITY=starttls
SMTP_TIMEOUT=8s
# 默认停用；部署后由组织所有者在“智能体配置”页面填写真实接口。
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT=30s
AI_RUN_LIMIT_PER_HOUR=20
# 启动可选对象存储：先将 STORAGE_DRIVER 改为 s3，再执行 docker compose --profile storage up
# 启动 Swagger UI：docker compose --profile docs up
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-change-me
